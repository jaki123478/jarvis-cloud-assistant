<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#020617">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="J.A.R.V.I.S. // IMAGE STUDIO"
        android:textColor="#00E5FF"
        android:textSize="20sp"
        android:gravity="center" />

    <ImageView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="centerInside"
        android:background="#081925" />

    <EditText
        android:id="@+id/prompt"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:hint="Descrivi, genera o modifica un'immagine..."
        android:textColor="@android:color/white"
        android:textColorHint="#6B8792"
        android:minLines="2"
        android:gravity="top" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnGallery"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="GALLERIA"
            android:textColor="#00E5FF"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnCamera"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="FOTOCAMERA"
            android:textColor="#00E5FF"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAnalyze"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="ANALIZZA"
            android:textColor="#00E5FF"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnEdit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="MODIFICA"
            android:textColor="#00E5FF"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="GENERA"
            android:textColor="#00E5FF"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="SALVA"
            android:textColor="#00E5FF"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="CONDIVIDI"
            android:textColor="#00E5FF"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/imgStatus"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:textColor="#8ED9E8"
        android:text="PRONTO // NESSUN FILE SALVATO" />

</LinearLayout>
