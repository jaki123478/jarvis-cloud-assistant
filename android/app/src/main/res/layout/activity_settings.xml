<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030A13">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙ J.A.R.V.I.S. // IMPOSTAZIONI"
            android:textColor="#00E5FF"
            android:textSize="22sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NOME UTENTE"
            android:textColor="#96DCE6"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/settingUserName"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Il tuo nome"
            android:textColor="@android:color/white"
            android:textColorHint="#507D8C"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:background="@drawable/input_border"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NUMERO TELEFONO PROMEMORIA"
            android:textColor="#96DCE6"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/settingPhone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="+39..."
            android:textColor="@android:color/white"
            android:textColorHint="#507D8C"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:inputType="phone"
            android:background="@drawable/input_border"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="URL BACKEND SERVER"
            android:textColor="#96DCE6"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/settingBackendUrl"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="https://..."
            android:textColor="@android:color/white"
            android:textColorHint="#507D8C"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:inputType="textUri"
            android:background="@drawable/input_border"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MODELLO AI // ENGINE"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <Spinner
            android:id="@+id/settingModel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/input_border" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHIAVE API / TOKEN HF (OPZIONALE)"
            android:textColor="#96DCE6"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/settingApiKey"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="hf_... o sk-... (opzionale)"
            android:textColor="@android:color/white"
            android:textColorHint="#507D8C"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:inputType="textPassword"
            android:background="@drawable/input_border"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PERSONALITÀ"
            android:textColor="#96DCE6"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <Spinner
            android:id="@+id/settingPersonality"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/input_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="20dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VOCE ATTIVA"
                android:textColor="#96DCE6"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <Switch
                android:id="@+id/settingVoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WAKE LOCK SCHERMO"
                android:textColor="#96DCE6"
                android:textSize="13sp"
                android:fontFamily="monospace" />

            <Switch
                android:id="@+id/settingWakeLock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MOTORE TTS (come PWA)"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <Spinner
            android:id="@+id/settingTtsEngine"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/input_border" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VOCE EDGE NEURAL"
            android:textColor="#96DCE6"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <Spinner
            android:id="@+id/settingEdgeVoice"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/input_border" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VELOCITÀ VOCE"
            android:textColor="#96DCE6"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:paddingTop="16dp"
            android:paddingBottom="4dp" />

        <SeekBar
            android:id="@+id/settingSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="SALVA CONFIGURAZIONE"
            android:textColor="#030A13"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:backgroundTint="#00E5FF" />

        <Button
            android:id="@+id/btnRestoreBackup"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:text="🔄 RIPRISTINA DA BACKUP"
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:background="@drawable/button_border" />

        <Button
            android:id="@+id/btnBackSettings"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="← TORNA A J.A.R.V.I.S."
            android:textColor="#00E5FF"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:background="@android:color/transparent" />

    </LinearLayout>
</ScrollView>
