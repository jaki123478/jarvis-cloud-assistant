# Inserisci qui la tua chiave API (OpenAI o xAI Grok)
LLM_API_KEY=sk-tuachiavequi

# Se usi xAI Grok, scommenta questa riga:
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-beta

# Se usi OpenAI:
LLM_MODEL=gpt-4o

# Modalità PC locale con llama.cpp (server OpenAI-compatible)
# LOCAL_LLM_MODE=true
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_API_KEY=local
# LLM_MODEL=jarvis-custom

# Image generation/editing (provider kept separate from chat)
IMAGE_PROVIDER=dashscope
IMAGE_API_KEY=la_tua_dashscope_key
IMAGE_MODEL=wanx2.1-t2i-turbo
IMAGE_EDIT_MODEL=wanx2.1-imageedit
# IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_HISTORY_ENABLED=false

# Qwen locale via Ollama o llama.cpp (OpenAI-compatible)
# QWEN_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# QWEN_LOCAL_MODEL=qwen2.5:7b

# Chiamate vocali AI tramite Plivo (provider predefinito; usa un numero Plivo e un URL HTTPS pubblico)
# VOICE_PROVIDER=plivo
# PUBLIC_BASE_URL=https://tuo-dominio.example.com
# PLIVO_AUTH_ID=MAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PLIVO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PLIVO_FROM_NUMBER=+39xxxxxxxxxx

# Alternativa Twilio:
# VOICE_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+39xxxxxxxxxx
