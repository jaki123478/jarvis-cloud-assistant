# Inserisci qui la tua chiave API (OpenAI o xAI Grok)
LLM_API_KEY=sk-tuachiavequi

# Se usi xAI Grok, scommenta questa riga:
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-beta

# Se usi OpenAI:
LLM_MODEL=gpt-4o

# Modalità PC locale con Ollama (attivare solo sul PC dove Ollama è installato)
# OLLAMA_MODE=true
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=jarvis-custom
